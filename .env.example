FLASK_APP=frameworks.flask_mvc.app:create_app
FLASK_DEBUG=1
SECRET_KEY=change-me
DATABASE_URL=sqlite:///chambeaya.db
APP_URL=http://127.0.0.1:5000

# Usa "console" para desarrollo sin correo o "smtp" para enviar mensajes reales.
MAIL_DELIVERY_MODE=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SENDER=ChambeaYa <no-reply@chambeaya.local>
MAIL_TIMEOUT=15

# Debe permanecer en false cuando MAIL_DELIVERY_MODE=smtp.
EXPOSE_AUTH_TOKENS=true
