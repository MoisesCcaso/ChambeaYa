FLASK_APP=bootstrap.app:create_app
FLASK_DEBUG=1
SECRET_KEY=change-me
DATABASE_URL=sqlite:///chambeaya.db
# API REST (bootstrap.app) en :5000 y cliente (client.app) en :5001, en el mismo host
# para que la cookie de sesión de la API viaje entre los dos puertos.
# URL del cliente: la usan los enlaces de los correos y el QR del certificado.
APP_URL=http://127.0.0.1:5001
# Orígenes del cliente que la API acepta por CORS (separados por coma).
CLIENT_ORIGINS=http://127.0.0.1:5001
# URL de la API que usa el cliente desde el navegador.
API_URL=http://127.0.0.1:5000

# Usa "console" para desarrollo sin correo o "smtp" para enviar mensajes reales.
MAIL_DELIVERY_MODE=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SENDER=ChambeaYa <no-reply@chambeaya.local>
MAIL_TIMEOUT=15

# Debe permanecer en false cuando MAIL_DELIVERY_MODE=smtp.
EXPOSE_AUTH_TOKENS=true

# Contraseña de las cuentas demo creadas por `flask seed-demo`.
DEMO_PASSWORD=Demo1234
